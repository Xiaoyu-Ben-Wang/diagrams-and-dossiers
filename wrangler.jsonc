{
  "name": "diagrams-and-dossiers",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    // Without this, a reload or a pasted /b/<id> 404s in production. _redirects
    // is a Pages convention and is not read here.
    "not_found_handling": "single-page-application"
  }
}
