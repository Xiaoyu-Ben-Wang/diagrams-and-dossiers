{
  "name": "diagrams-and-dossiers",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-07",
  // Cloudflare creates the DNS record and certificate for this on deploy.
  "routes": [{ "pattern": "diagrams.wxyben.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, a reload or a pasted /b/<id> 404s in production. Workers
    // does read _redirects, but rejects the "/* /index.html 200" rule as an
    // infinite loop, so the fallback can only live here — do not re-add it.
    "not_found_handling": "single-page-application",
    // Only picture uploads and reads reach the Worker; everything else is served
    // straight from the assets.
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "diagrams-and-dossiers-images"
    }
  ],
  // SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are set as runtime variables in the
  // dashboard; this stops a deploy from wiping them.
  "keep_vars": true
}
