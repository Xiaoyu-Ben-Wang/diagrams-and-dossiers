# Copy to .env.local and fill in from the Supabase dashboard (Settings → API).
# Both values are public: they ship to the browser in the bundle. RLS is what
# protects the data, and the database password does not belong here.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key, sb_publishable_…>
